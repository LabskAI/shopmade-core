{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://shopmade.pro/schemas/plugin.json",
    "title": "Shopmade plugin manifest",
    "type": "object",
    "additionalProperties": false,
    "required": ["slug", "name", "version", "summary", "provider", "mount", "public", "nav", "tables", "depends", "design_system"],
    "properties": {
        "slug": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,40}$"
        },
        "name": {
            "type": "string",
            "minLength": 1
        },
        "version": {
            "type": "string",
            "minLength": 1
        },
        "summary": {
            "type": "string"
        },
        "provider": {
            "type": "string",
            "pattern": "^Plugins\\\\[A-Za-z][A-Za-z0-9]*\\\\ServiceProvider$"
        },
        "mount": {
            "type": "string",
            "pattern": "^(/|/p/[a-z][a-z0-9-]{1,40})$"
        },
        "public": {
            "type": "boolean"
        },
        "nav": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "route", "roles"],
                "properties": {
                    "label": { "type": "string", "minLength": 1 },
                    "route": { "type": "string", "minLength": 1 },
                    "roles": {
                        "type": "array",
                        "items": { "type": "string", "enum": ["super_admin", "admin", "user", "client"] },
                        "minItems": 1
                    }
                }
            }
        },
        "attach": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["plugin", "label", "route"],
            "properties": {
                "plugin": { "type": "string", "minLength": 1 },
                "label": { "type": "string", "minLength": 1 },
                "route": { "type": "string", "minLength": 1 }
            }
        },
        "tables": {
            "type": "array",
            "items": { "type": "string", "pattern": "^p_[a-z0-9_]+$" }
        },
        "depends": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
        },
        "design_system": {
            "type": "integer",
            "minimum": 1
        }
    }
}
