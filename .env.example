APP_NAME=Shopmade
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_ORG_NAME=Shopmade
# When set, `/` redirects to this public URL instead of the built-in site under AGENTS_FRONT_PREFIX.
PUBLIC_HOME_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=shopmade
DB_USERNAME=shopmade
DB_PASSWORD=shopmade
DB_QUEUE_TABLE=queue_jobs

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Must match the APP_URL host so the app and its front host share the session cookie.
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=

# Behind a proxy that terminates HTTPS, trust it so URLs and cookies use https (`*` or a comma-separated IP list).
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Signed client-portal set-password links expire after this many hours.
PORTAL_INVITE_TTL_HOURS=72

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Website front and MCP server (docs/front/README.md).
AGENTS_COMPANY=demo
# AGENTS_REPO_DIR=
AGENTS_FRONT_PREFIX=site
# AGENTS_FRONT_HOST=
AGENTS_MCP_RATE_LIMIT=60
AGENTS_MCP_MAX_BATCH=10
# Extra exact OAuth redirect URIs, comma-separated. Trimmed; empties dropped; no wildcards.
# AGENTS_OAUTH_EXTRA_REDIRECT_URIS=
# Defaults to true only when APP_ENV is local or testing (MCP Inspector / Claude Code localhost callbacks).
# AGENTS_OAUTH_ALLOW_LOOPBACK=

VITE_APP_NAME="${APP_NAME}"
